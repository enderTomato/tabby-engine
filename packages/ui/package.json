{
  "name": "@tabby/ui",
  "version": "0.1.0",
  "description": "Tabby Engine UI 原语：离屏缩略图、DOM 标签池、旋钮面板核心、toast 队列（框架无关）",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@tabby/core": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
