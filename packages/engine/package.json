{
  "name": "@tabby/engine",
  "version": "0.1.0",
  "description": "Tabby Engine 门面：能力探测、分档预算、主循环、物理宿主、视图适配与自适应降级",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@tabby/core": "workspace:*",
    "@tabby/physics": "workspace:*",
    "@tabby/platform": "workspace:*",
    "@tabby/worker": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
