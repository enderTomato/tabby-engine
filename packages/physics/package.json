{
  "name": "@tabby/physics",
  "version": "0.1.0",
  "description": "Tabby Engine 自研轻量物理：SPH-lite 流体、Verlet 布娃娃/绳索、解析摆、烟雾粒子。零渲染依赖，可在 Worker 内运行",
  "license": "MPL-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/api/public.js",
  "types": "./dist/api/public.d.ts",
  "exports": {
    ".": {
      "types": "./dist/api/public.d.ts",
      "import": "./dist/api/public.js"
    },
    "./extension": {
      "types": "./dist/api/extension.d.ts",
      "import": "./dist/api/extension.js"
    },
    "./presets": {
      "types": "./dist/api/presets.d.ts",
      "import": "./dist/api/presets.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test tests/*.test.mjs",
    "api-report": "node scripts/api-snapshot.mjs",
    "docs": "typedoc"
  },
  "dependencies": {
    "@tabby/core": "workspace:*"
  },
  "devDependencies": {
    "typedoc": "^0.28.20",
    "typescript": "^5.6.0"
  }
}
